# Copiar a .env (o exportar como variables de entorno) y ajustar valores.
DATABASE_URL=jdbc:postgresql://localhost:5432/kindergarten
DATABASE_USER=kindergarten
DATABASE_PASSWORD=kindergarten

# Secreto HMAC para firmar los JWT (minimo 32 caracteres). CAMBIAR en produccion.
JWT_SECRET=){,l%.-4=_50joHk6M}]zL}]hb17,Mg%XVCIke>qe-z
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=back-kindergarten-api

# Origenes permitidos por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Usuario administrador sembrado solo con el perfil dev.
# SEED_ADMIN_PASSWORD es obligatorio cuando app.seed.enabled=true (perfil dev).
SEED_ENABLED=true
SEED_ADMIN_EMAIL=director@ueclca.edu.ve
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=Direccion

# Archivos subidos (imagenes/videos de publicaciones).
# La base publica debe ser accesible por el navegador. Las portadas subidas se envian a Telegram
# directamente (multipart); solo una imageUrl externa debe ser accesible por Telegram.
MEDIA_STORAGE_PATH=./uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:8080
MEDIA_MAX_FILE_SIZE_BYTES=52428800

# Telegram (opcional). Crear un bot con @BotFather y agregarlo como admin del canal.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opcionales: TELEGRAM_API_BASE_URL, TELEGRAM_CONNECT_TIMEOUT_MS, TELEGRAM_READ_TIMEOUT_MS
