# Copiar a .env (o exportar como variables de entorno) y ajustar valores.
DATABASE_URL=jdbc:postgresql://localhost:5432/kindergarten
DATABASE_USER=kindergarten
DATABASE_PASSWORD=kindergarten

# Secreto HMAC para firmar los JWT (mínimo 32 caracteres). CAMBIAR en producción.
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=60

# Orígenes permitidos por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Usuario administrador sembrado solo con el perfil dev.
SEED_ADMIN_EMAIL=admin@ueclca.edu.ve
SEED_ADMIN_PASSWORD=admin1234
SEED_ADMIN_FULL_NAME=Administrador
